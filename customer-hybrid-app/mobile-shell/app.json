{
  "expo": {
    "name": "Makaano",
    "slug": "customer-superapp-shell",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.customer.superapp"
    },
    "android": {
      "package": "com.customer.superapp",
      "permissions": [
        "INTERNET",
        "VIBRATE",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#C7ECF8",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sharing",
      "expo-updates",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Makaano uses your location to show stores and delivery times near you."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E2238",
          "image": "./assets/splash-icon.png",
          "imageWidth": 220
        }
      ]
    ]
  }
}
